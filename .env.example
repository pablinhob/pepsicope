# =====================================================================
#  Boldest Periscope — configuración
#  Copia este archivo a .env (./workspace-periscope.sh setup lo hace por ti)
# =====================================================================

# ---------------------------------------------------------------------
#  Bitbucket Cloud
# ---------------------------------------------------------------------
# El código se descarga por SSH con tu clave (comprueba: ssh -T git@bitbucket.org).
# El email + token solo se usan para la API REST: listar los repos del workspace,
# proyectos, miembros y metadatos (fecha de creación, privado/público...), que NO
# se pueden obtener por SSH.

# Slug del workspace (lo que aparece en https://bitbucket.org/<workspace>/)
BITBUCKET_WORKSPACE=

# Email de tu cuenta Atlassian + API token de solo lectura.
# Crea el token en https://id.atlassian.com/manage-profile/security/api-tokens
#   -> "Create API token with scopes" -> app Bitbucket, con los scopes:
#      read:workspace:bitbucket, read:project:bitbucket,
#      read:repository:bitbucket, read:user:bitbucket
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=

# ---------------------------------------------------------------------
#  IA (Claude)
# ---------------------------------------------------------------------
# Se usa el Claude Code instalado con tu sesión: consume de tu plan de Claude.
# No hace falta ninguna clave ni créditos de API.
# claude-cli -> con IA
# none       -> sin IA: solo detección determinista
AI_BACKEND=claude-cli

# Ruta al binario de Claude Code y modelo (opus | sonnet | haiku). sonnet gasta menos de tu plan.
CLAUDE_CLI_PATH=claude
CLAUDE_MODEL=opus

# Llamadas a la IA en paralelo, timeout por llamada (s) y tamaño máximo del diff enviado
AI_WORKERS=3
AI_TIMEOUT=900
AI_MAX_DIFF_CHARS=60000
# Máximo de llamadas a la IA por ejecución (0 = sin límite). Útil en el primer informe.
AI_MAX_CALLS=0

# ---------------------------------------------------------------------
#  Funcionalidades (1 = activada, 0 = desactivada)
# ---------------------------------------------------------------------
FEATURE_NEW_REPOS=1             # Repositorios nuevos (creador, fecha, lenguaje, stack)
FEATURE_DELETED_REPOS=1         # Repositorios eliminados
FEATURE_REPO_METADATA=1         # Renombrados, cambios de visibilidad, de proyecto o de rama principal
FEATURE_WORKSPACE=1             # Proyectos y miembros nuevos/eliminados del workspace
FEATURE_BRANCHES=1              # Ramas nuevas (pista de trabajo en curso o funcionalidad oculta)
FEATURE_LIBRARIES=1             # Bibliotecas añadidas/eliminadas/actualizadas y quién las metió
FEATURE_FRAMEWORKS=1            # Frameworks y sub-frameworks nuevos o cambiados
FEATURE_EXTERNAL_SERVICES=1     # SDKs, hosts e imágenes de servicios externos nuevos (lee el código)
FEATURE_PRACTICES=1             # Forma de trabajar: tests, docblocks, linters, tooling de IA...
FEATURE_INFRA=1                 # Virtualización / contenedores / IaC
FEATURE_CONFIG_PIPELINES=1      # Cambios en pipelines y archivos de configuración clave
FEATURE_AI_REPO_PURPOSE=1       # IA: interpretar para qué sirve cada repo nuevo
FEATURE_AI_CHANGE_ANALYSIS=1    # IA: analizar los cambios de cada repo (intenciones, servicios, func. ocultas)
FEATURE_AI_SUMMARY=1            # IA: resumen final del informe
FEATURE_AUDIT_LOG=0             # Consultar el audit log de Atlassian (requiere Atlassian Guard + clave admin)

# Audit log de la organización (solo si FEATURE_AUDIT_LOG=1)
# https://admin.atlassian.com -> Settings -> API keys
ATLASSIAN_ORG_ID=
ATLASSIAN_ADMIN_API_KEY=

# ---------------------------------------------------------------------
#  Alcance y rendimiento
# ---------------------------------------------------------------------
# Expresiones regulares sobre el slug del repo (vacío = todos)
REPO_INCLUDE=
REPO_EXCLUDE=
# Máximo de repos a procesar (0 = todos). Útil para probar.
MAX_REPOS=0
# Clones/fetch de git en paralelo
GIT_WORKERS=4
# Idioma de los informes
REPORT_LANGUAGE=español
