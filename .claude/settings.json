{
  "permissions": {
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git revert *)",
      "Bash(git cherry-pick *)",
      "Bash(git tag *)",
      "Bash(git am *)",
      "Bash(git apply *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(git init *)",
      "Bash(git update-ref *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git submodule *)",
      "Bash(git worktree *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh repo *)",
      "Bash(gh release *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-repo-writes.py",
            "onFailure": "block",
            "statusMessage": "Comprobando que el comando no modifica git ni código remoto"
          }
        ]
      }
    ]
  }
}
